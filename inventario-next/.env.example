# Inventario Next local configuration
# Keep real secrets in .env only. Never commit real credentials.

APP_ENV=local
PUBLIC_APP_NAME="Inventario Next"

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=inventario_dev
MYSQL_USER=inventario_user
MYSQL_PASSWORD=change-me
MYSQL_READ_ONLY=true

AD_URL=ldaps://ad.example.local:636
AD_BASE_DN=DC=example,DC=local
AD_DOMAIN=example.local
AD_SYNC_USER=svc_inventario@example.local
AD_SYNC_PASSWORD=change-me
AD_TLS_REJECT_UNAUTHORIZED=true

TLS_CERT_PATH=../cert.pem
TLS_KEY_PATH=../key.pem
